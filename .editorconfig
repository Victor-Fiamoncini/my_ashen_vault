# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python: PEP 8 indentation, line length matches ruff (pyproject.toml).
[*.py]
max_line_length = 110

# GLSL shaders
[*.{vs,fs,glsl}]
indent_size = 4

[*.{toml,yml,yaml,json,svg}]
indent_size = 2

# Two trailing spaces are a hard line break in Markdown.
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Tile maps are whitespace-sensitive grids: never touch them.
[*.map]
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
